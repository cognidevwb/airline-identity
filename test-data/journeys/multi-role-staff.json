      "ref": "userclaim-staff-desk",
      "table": "UserClaim",
      "values": {
        "ClaimType": "desk",
        "ClaimValue": "terminal-2",
        "Id": 1,
        "UserId": "user-staff",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Request the roles and the effective claims for priya.venkataraman@skyline-air.example, then try one booking-management action and one fleet-management action as this user."
    }
  ],
  "expect": [
    "The roles list contains Agent and Admin, each once. The effective claims are bookings.manage and fleet.manage from the roles, plus the user-level desk=terminal-2 claim. Both the booking-management and fleet-management actions are authorized. A user with only the Agent role would be refused the fleet action."
  ]
}
