        "Email": "priya.venkataraman@skyline-air.example",
        "EmailConfirmed": true,
        "FirstName": "Priya",
        "Id": "b1c2d3e4-0003-4000-8000-000000000103",
        "LastName": "Venkataraman",
        "LockoutEnabled": true,
        "LockoutEnd": null,
        "NormalizedEmail": "PRIYA.VENKATARAMAN@SKYLINE-AIR.EXAMPLE",
        "NormalizedUserName": "PRIYA.VENKATARAMAN@SKYLINE-AIR.EXAMPLE",
        "PassPortNumber": "K2468135",
        "PasswordHash": "AQAAAAEAACcQAAAAEFakeHashStaff==",
        "PhoneNumber": "+912212345603",
        "PhoneNumberConfirmed": true,
        "SecurityStamp": "ss-user-staff-2",
        "TwoFactorEnabled": true,
